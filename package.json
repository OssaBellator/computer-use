{
  "name": "semantic-browser-interaction-engine",
  "version": "0.42.0",
  "description": "Framework-independent browser-agent foundation with raw Chromium CDP, bounded tasks, structured research, rich editing, media/permission state, realtime control, and commitment safety",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests",
    "test:chromium": "npm run build && node --test dist/tests/integration",
    "test:live": "RUN_LIVE_WEB=1 npm run test:chromium"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "typescript": "^5.8.3"
  },
  "keywords": [
    "browser-automation",
    "browser-agent",
    "accessibility",
    "semantic",
    "cdp",
    "chromium",
    "automation",
    "hci"
  ],
  "license": "MIT"
}
